APP_ENV=development
# Host-side API (go run ./cmd) uses localhost. Compose overrides DATABASE_URL to postgres:5432.
DATABASE_URL=postgres://relper:relper@localhost:5432/relper?sslmode=disable
# At least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=local-dev-only-32-bytes-minimum-change-me
